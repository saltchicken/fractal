#version 430 core
layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// --- Data Structures ---
struct Point {
    vec4 position;
    vec4 color;
};

struct Transform {
    vec4 params1;
    vec4 params2;
    vec4 color;
    uvec4 variation;
};

// --- Buffers ---
layout(std430, binding = 0) readonly buffer TransformBlock {
    Transform transforms[];
};

layout(std430, binding = 1) buffer PointBlock {
    Point points[];
};

// --- Uniforms ---
uniform uint num_transforms;
uniform uint total_points;
uniform uint seed;
uniform uint u_warmup_iterations;
uniform uint u_main_iterations;

// --- Helper Functions ---
const float PI = 3.1415926535;

uint hash(uint x) {
    x += (x << 10u);
    x ^= (x >> 6u);
    x += (x << 3u);
    x ^= (x >> 11u);
    x += (x << 15u);
    return x;
}

float random(inout uint state) {
    state = hash(state);
    return float(state) / float(0xFFFFFFFFu);
}

vec2 apply_variations(vec2 p, uint var_enum) {
    switch (var_enum) {
        case 0: // LINEAR
            return p;
        case 1: // SINUSOIDAL
            return sin(p);
        case 2: // SPHERICAL
            float r2_sph = dot(p, p);
            if (r2_sph > 1e-6) return p / r2_sph;
            return p;
        case 3: // SWIRL
            float r2_sw = dot(p, p);
            return vec2(p.x * sin(r2_sw) - p.y * cos(r2_sw), p.x * cos(r2_sw) + p.y * sin(r2_sw));
        case 4: // HORSESHOE
            float r_hs = length(p);
            if (r_hs > 1e-6) return vec2((p.x - p.y) * (p.x + p.y), 2.0 * p.x * p.y) / r_hs;
            return p;
        case 5: // POLAR
            return vec2(atan(p.y, p.x) / PI, length(p) - 1.0);
        case 6: // HEART
            float r_h = length(p);
            float theta_h = atan(p.y, p.x);
            return r_h * vec2(sin(theta_h * r_h), -cos(theta_h * r_h));
        case 7: // DISK
            float r_d = length(p);
            float theta_d = atan(p.y, p.x);
            return (theta_d / PI) * vec2(sin(PI * r_d), cos(PI * r_d));
        case 8: // SPIRAL
            float r_sp = length(p);
            float theta_sp = atan(p.y, p.x);
            if (r_sp > 1e-6) return (1.0 / r_sp) * vec2(cos(theta_sp) + sin(r_sp), sin(theta_sp) - cos(r_sp));
            return p;
        case 9: // HYPERBOLIC
            float r_hy = length(p);
            float theta_hy = atan(p.y, p.x);
            if (r_hy > 1e-6) return vec2(sin(theta_hy) / r_hy, r_hy * cos(theta_hy));
            return p;
    }
    return p;
}

// --- Main Execution ---
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= total_points) return;

    uint rand_state = hash(index + seed);
    vec2 current_point = vec2(random(rand_state) * 2.0 - 1.0, random(rand_state) * 2.0 - 1.0);
    
    // Warm-up iterations to let the point settle onto the attractor
    for (int i = 0; i < u_warmup_iterations; ++i) {
        uint t_idx = uint(random(rand_state) * num_transforms);
        Transform t = transforms[t_idx];
        current_point = vec2(t.params1.x * current_point.x + t.params1.y * current_point.y + t.params1.z, t.params1.w * current_point.x + t.params2.x * current_point.y + t.params2.y);

        // Calculate the result of BOTH variations
        vec2 point_from = apply_variations(current_point, t.variation.x);
        vec2 point_to   = apply_variations(current_point, t.variation.y);

        // Smoothly blend the results using the alpha we passed in
        current_point = mix(point_from, point_to, t.params2.z);
    }
    
    vec3 accumulated_color = vec3(0.0);
    float final_alpha = 0.0; // Variable to store the last used alpha

    // Main iterations to find the final point position and color
    for (int i = 0; i < u_main_iterations; i++) {
        uint t_idx = uint(random(rand_state) * num_transforms);
        Transform t = transforms[t_idx];
        
        // Apply affine transform and variation
        current_point = vec2(t.params1.x * current_point.x + t.params1.y * current_point.y + t.params1.z, t.params1.w * current_point.x + t.params2.x * current_point.y + t.params2.y);

        // Calculate the result of BOTH variations
        vec2 point_from = apply_variations(current_point, t.variation.x);
        vec2 point_to   = apply_variations(current_point, t.variation.y);

        // Smoothly blend the results using the alpha we passed in
        current_point = mix(point_from, point_to, t.params2.z);

        // Blend the color at each step
        if (i == 0) {
            accumulated_color = t.color.rgb; // Set the initial color
        } else {
            accumulated_color = (accumulated_color + t.color.rgb) * 0.5; // Average with subsequent colors
        }
        final_alpha = t.color.a; // Update the alpha in every iteration
    }

    points[index].position = vec4(current_point, 0.0, 1.0);
    points[index].color = vec4(accumulated_color, final_alpha);
}
